{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "skills": [
    "~/.dotfiles/claude/.claude/local-plugins/workflow/skills",
    "~/.dotfiles/claude/.claude/local-plugins/writing/skills",
    "~/.dotfiles/claude/.claude/local-plugins/engineering/skills",
    "~/.dotfiles/claude/.claude/local-plugins/typescript/skills",
    "~/.dotfiles/claude/.claude/local-plugins/aspire/skills",
    "~/.dotfiles/claude/.claude/local-plugins/nextjs/skills"
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "pnpx",
          "chrome-devtools-mcp@latest"
        ]
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp"
      }
    }
  }
}
