{
  "respectGitignore": false,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "@DOTFILES@/claude/.claude/local-plugins"
  },
  "permissions": {
    "deny": [
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.secrets)",
      "Read(~/.secrets)",
      "Read(**/local.settings.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(~/.ssh/id_*)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pgpass)",
      "Read(~/.aws/credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir' | tr '\\\\' '/'); branch=$(git -C \"$dir\" --no-optional-locks symbolic-ref --short HEAD 2>/dev/null); printf '\\033[1;38;2;80;250;123m%s\\033[0m' \"$(basename \"$dir\")\"; [ -n \"$branch\" ] && printf ' \\033[1;38;2;255;121;198m%s\\033[0m' \"$branch\"; true"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "dracula@claude-themes": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "storyblok": {
      "source": {
        "source": "github",
        "repo": "storyblok/agent-plugin"
      }
    },
    "claude-themes": {
      "source": {
        "source": "github",
        "repo": "matcra587/claude-themes"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "feedbackDrafts": "quiet",
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "session-status@inline": {
      "options": {
        "rotateSeconds": 30
      }
    }
  },
  "theme": "custom:dracula:dracula"
}
