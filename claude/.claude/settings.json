{
  "respectGitignore": false,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/claude/.claude/local-plugins"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.secrets)",
      "Read(~/.secrets)",
      "Read(**/local.settings.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(~/.ssh/id_*)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pgpass)",
      "Read(~/.aws/credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "dracula@claude-themes": true,
    "sub-meter@statuslines": true,
    "context-bar@statuslines": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "storyblok": {
      "source": {
        "source": "github",
        "repo": "storyblok/agent-plugin"
      }
    },
    "claude-themes": {
      "source": {
        "source": "github",
        "repo": "matcra587/claude-themes"
      }
    },
    "statuslines": {
      "source": {
        "source": "url",
        "url": "https://statuslin.es/marketplace.json"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "feedbackDrafts": "quiet",
  "pluginConfigs": {
    "sub-meter@statuslines": {
      "options": {
        "rotateSeconds": 30,
        "hideCycleHint": true
      }
    }
  },
  "theme": "custom:dracula:dracula"
}
